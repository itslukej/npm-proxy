# Port the proxy listens on.
PORT=3000

# Upstream npm registry. All upstream traffic goes here and nowhere else.
UPSTREAM_REGISTRY=https://registry.npmjs.org

# Public base URL clients use to reach THIS proxy. Baked into the rewritten
# dist.tarball URLs (and therefore into package-lock "resolved" fields), so it
# must be the externally reachable URL, not localhost.
PUBLIC_REGISTRY_URL=https://npm-proxy.example.com

# Minimum package age. If MIN_PACKAGE_AGE_HOURS is set it WINS over
# MIN_PACKAGE_AGE_DAYS. Default: 7 days.
MIN_PACKAGE_AGE_DAYS=7
#MIN_PACKAGE_AGE_HOURS=168

# How long raw upstream packuments are cached in memory (seconds).
METADATA_CACHE_TTL_SECONDS=300

# How long upstream 404s are cached (seconds). Errors (5xx/timeouts) are never cached.
#NEGATIVE_CACHE_TTL_SECONDS=60

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated package names that bypass the age policy entirely.
#MIN_AGE_EXCLUDE_PACKAGES=@my-company/foo,emergency-package

# Comma-separated exact name@version pairs that bypass the age policy.
#MIN_AGE_EXCLUDE_VERSIONS=foo@1.2.3,@scope/bar@4.5.6

# Directory for the on-disk cache of allowed tarballs. Empty/unset disables it.
#TARBALL_CACHE_DIR=/cache

# Advanced tuning (defaults shown).
#UPSTREAM_TIMEOUT_MS=10000
#MAX_METADATA_BYTES=67108864
#METADATA_CACHE_MAX_BYTES=268435456
